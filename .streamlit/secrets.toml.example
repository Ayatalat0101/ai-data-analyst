# Copy this file to secrets.toml (same folder) and paste your real keys.
# secrets.toml is listed in .gitignore, so it is never uploaded to GitHub.
# On Streamlit Community Cloud, paste the same lines in App settings -> Secrets.
GEMINI_API_KEY = "paste-your-gemini-key-here"
# Planning is a small task; Flash-Lite usually has higher free limits than Flash.
GEMINI_MODEL = "gemini-flash-lite-latest"
GROQ_API_KEY = ""   # optional backup (console.groq.com)
# Public demo: AI-planned questions per visitor session, then the rule planner answers.
AI_QUESTIONS_PER_SESSION = 20
